# Every variable is optional — the site builds and runs with none set and degrades gracefully.

# AI assistant + JD matcher (features show a friendly "offline" state if missing)
GEMINI_API_KEY=

# Max requests per day that may reach the paid model (chat + job matcher combined). Default 400.
AI_DAILY_LIMIT=

# Read-only public GitHub data for contributions/activity (fallback: generated/github-snapshot.json)
GITHUB_TOKEN=

# Contact form delivery (fallback: mailto + copy-email)
RESEND_API_KEY=
CONTACT_TO_EMAIL=vishalbg02@gmail.com

# Optional shared rate limiting / daily AI cap (fallback: per-instance in-memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL used for canonical URLs, sitemap and OG images
NEXT_PUBLIC_SITE_URL=https://vishalbg.vercel.app

# Optional Google Search Console verification token
NEXT_PUBLIC_GSC_VERIFICATION=

# Recognition strip on the home page
SHOW_RECOGNITION=true

# Live chat (Phase 4). All optional: without them the site shows "Leave a message" and uses the contact form.
# Step-by-step: docs/LIVE-CHAT-SETUP.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
LIVE_CHAT_SIGNING_SECRET=
CRON_SECRET=
# Optional bot check on the first message
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
